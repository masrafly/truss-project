APP_ENV=development
APP_PORT=8080
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# disable (lokal) | require | verify-full (produksi)
DB_SSLMODE=disable

# Auth
# Wajib minimal 32 byte acak. Buat dengan: go run ./cmd/genjwtsecret
JWT_SECRET=
# BELUM DIPAKAI: masa berlaku token saat ini tetap 24 jam (di cmd/api/main.go)
JWT_EXPIRES_IN=24h

# Opsional: IP/CIDR reverse proxy yang dipercaya untuk X-Forwarded-For,
# dipisah koma. Kosong = tidak ada (aman untuk lokal).
TRUSTED_PROXIES=

# Frontend (React / Vite)
VITE_API_BASE_URL=http://localhost:8080
